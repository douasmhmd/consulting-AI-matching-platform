# Copier ce fichier en .env et renseigner les valeurs reelles.
# NE JAMAIS commiter le fichier .env (il est dans .gitignore).

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=changeme

# OpenAI - cle API pour le service IA
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Firebase - chemin vers le fichier de compte de service
FIREBASE_CONFIG_PATH=./firebase-service-account.json

# JWT
JWT_SECRET=changeme-secret-key-min-32-characters
JWT_EXPIRATION_MS=86400000
